{
  "facebook": {
    "match": "^https?://(?:(?:www|m|web|mbasic)\\.)?facebook\\.com/share/",
    "loginWall": {
      "match": "^https?://(?:(?:www|m|web|mbasic)\\.)?facebook\\.com/login",
      "param": "next"
    },
    "normalizeHost": {
      "m.facebook.com": "www.facebook.com",
      "web.facebook.com": "www.facebook.com",
      "mbasic.facebook.com": "www.facebook.com",
      "facebook.com": "www.facebook.com"
    },
    "shareId": "/share/(?:[a-z]/)?([^/?#]+)"
  },
  "threads": {
    "match": "^https?://(?:www\\.)?threads\\.(com|net)/share/",
    "shareId": "/share/([^/?#]+)"
  },
  "tiktok": {
    "match": "^https?://(?:(?:vt|vm)\\.tiktok\\.com/|(?:www\\.)?tiktok\\.com/t/)",
    "shareId": "^/(?:t/)?([^/?#]+)"
  },
  "bilibili": {
    "match": "^https?://(?:b23\\.tv|bili2233\\.cn)/",
    "shareId": "^/(?!(?:BV|av)[0-9A-Za-z])([^/?#]+)"
  },
  "generic": {
    "match": "^https?://(bit\\.ly|t\\.co|lnkd\\.in|amzn\\.to|shp\\.ee|fb\\.me)/"
  }
}
