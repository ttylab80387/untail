{
  "providers": {
    "threads": {
      "urlPattern": "^https?:\\/\\/(?:[a-z0-9-]+\\.)*?threads\\.(?:com|net)(?:[/:?#]|$)",
      "rules": [
        "xmt",
        "slof"
      ]
    },
    "facebook": {
      "rules": [
        "rdid",
        "share_url"
      ]
    },
    "facebook photo": {
      "urlPattern": "^https?:\\/\\/(?:[a-z0-9-]+\\.)*?facebook\\.com\\/photo\\.php\\?",
      "rules": [
        "mibextid",
        "rdid",
        "share_url"
      ]
    },
    "tiktok.com": {
      "rules": [
        "share_item_id",
        "share_app_id",
        "sender_device",
        "is_from_webapp",
        "share_link_id",
        "social_share_type"
      ]
    },
    "pinterest": {
      "urlPattern": "^https?:\\/\\/(?:[a-z0-9-]+\\.)*?pinterest\\.(?:com|[a-z]{2}|co\\.[a-z]{2}|com\\.[a-z]{2})(?:[/:?#]|$)",
      "rules": [
        "invite_code",
        "sender",
        "sfo",
        "mt"
      ]
    },
    "snapchat.com": {
      "rules": [
        "share_id"
      ]
    },
    "LinkedIn": {
      "rules": [
        "rcm"
      ]
    },
    "bilibili.com": {
      "rules": [
        "bbid",
        "ts"
      ]
    },
    "xiaohongshu.com": {
      "rules": [
        "share_channel"
      ]
    },
    "instagram": {
      "rules": [
        "stkn",
        "exln"
      ]
    },
    "line.me-oa": {
      "urlPattern": "^https?:\\/\\/line\\.me\\/R\\/ti\\/p\\/",
      "rules": [
        "oat_content",
        "ts"
      ]
    },
    "click ids": {
      "urlPattern": ".*",
      "rules": [
        "fbclid",
        "gclid",
        "dclid",
        "msclkid",
        "twclid",
        "yclid"
      ]
    },
    "instagram rotating share id": {
      "urlPattern": "^https?:\\/\\/(?:(?:(?:www|m)\\.)?instagram\\.com|instagr\\.am)\\/(?:reels?|p)\\/[^/?#]+\\/?(?:[?#]|$)",
      "rules": [
        "[a-z]{4}"
      ]
    },
    "trip.com hotel": {
      "urlPattern": "^https?:\\/\\/(?:[a-z0-9-]+\\.)*?trip\\.com\\/m\\/hotels\\/v2\\/detail\\/?(?:[?#]|$)",
      "rules": [
        "UniqueKey",
        "masterhotelid_tracelogid",
        "fromPageId",
        "fromList",
        "listScene",
        "isFirstEnterDetailPage",
        "subStamp"
      ]
    }
  }
}
