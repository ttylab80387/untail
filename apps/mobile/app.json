{
  "expo": {
    "name": "Untail",
    "slug": "untail",
    "scheme": "untail",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.ttylab.untail",
      "supportsTablet": true
    },
    "android": {
      "package": "com.ttylab.untail",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-foreground.png",
        "monochromeImage": "./assets/monochrome.png",
        "backgroundColor": "#0f6b5f"
      },
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.VIBRATE"
      ]
    },
    "plugins": [
      "expo-router",
      ["expo-localization", { "supportedLocales": ["zh-Hant", "en", "ja"] }],
      [
        "expo-share-intent",
        {
          "iosActivationRules": {
            "NSExtensionActivationSupportsWebURLWithMaxCount": 1,
            "NSExtensionActivationSupportsWebPageWithMaxCount": 1,
            "NSExtensionActivationSupportsText": true
          },
          "androidIntentFilters": ["text/*"]
        }
      ],
      "./plugins/withReleaseSigning",
      [
        "expo-splash-screen",
        { "image": "./assets/adaptive-foreground.png", "imageWidth": 200, "resizeMode": "contain", "backgroundColor": "#0d1714" }
      ]
    ]
  }
}
